# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (omit to reflect any origin)
CORS_ORIGIN=http://localhost:3000
# Public base URL of the frontend (used to build links in emails)
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=

# Auth (use long, random values; these are the only JWT secrets used)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Email (Resend). Create a sending key at https://resend.com/api-keys.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (mail.amanuel.work).
MAIL_FROM=AMR Blog <noreply@mail.amanuel.work>

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Swagger (optional: override the production server base URL)
SWAGGER_SERVER_URL=
